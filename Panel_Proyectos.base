filters:
  and:
    - file.ext == "md"
properties:
  note.estado:
    displayName: Estado
  note.entidad:
    displayName: Entidad
  note.cui:
    displayName: CUI
  note.ubicacion:
    displayName: Ubicación
  note.especialidad:
    displayName: Especialidad
  note.tipo:
    displayName: Tipo
  note.monto:
    displayName: Monto S/
  note.fecha_actualizacion:
    displayName: Actualizado
views:
  - type: table
    name: Proyectos
    filters:
      and:
        - note.categoria == "proyecto"
    order:
      - file.name
      - estado
      - entidad
      - cui
      - ubicacion
      - fecha_actualizacion
    sort:
      - property: estado
        direction: ASC
  - type: table
    name: Pendientes
    filters:
      or:
        - note.estado == "pendiente-vaciado"
        - note.estado == "en-construccion"
        - note.estado == "BORRADOR-NO-EMITIBLE"
        - note.estado == "observado"
    order:
      - file.name
      - estado
      - entidad
      - fecha_actualizacion
  - type: table
    name: Datos incompletos
    filters:
      and:
        - note.categoria == "proyecto"
        - or:
            - note.estado.isEmpty()
            - note.cui.isEmpty()
            - note.entidad.isEmpty()
    order:
      - file.name
      - estado
      - entidad
      - cui
  - type: table
    name: Normativa
    filters:
      and:
        - note.tipo == "norma"
    order:
      - file.name
      - numero
      - rango
      - estado
  - type: table
    name: Conceptos
    filters:
      and:
        - note.tipo == "concepto"
    order:
      - file.name
      - normativa
  - type: table
    name: Todo el vault
    order:
      - file.name
      - tipo
      - estado
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
